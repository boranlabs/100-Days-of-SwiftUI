enum functionError: Error {
    case invalidName
    case invalidEarning
}

func getEarning(name: String, earning: Int) throws -> (name: String, interest: Double, loan: Bool) {
    if name.replacingOccurrences(of: " ", with: "").isEmpty {
        throw functionError.invalidName
    }
    
    if earning < 0 {
        throw functionError.invalidEarning
    }
    var interest: Double
    if earning >= 1_000_000 {
        interest = 2.99
    } else if earning >= 100_000 {
        interest = 1.99
    } else if earning > 2_000 && earning < 100_000 {
                interest = 0.99
    } else {
        interest = 0.0
    }
    return (name, interest, interest > 0 )
}

do {
    let result = try getEarning(name: "Betül", earning: 1_223_237)
    print(result.name, result.interest, result.loan)
} catch functionError.invalidName {
    print("Invalid name.")
} catch functionError.invalidEarning {
    print("You can't enter an earning less than 0.")
}
