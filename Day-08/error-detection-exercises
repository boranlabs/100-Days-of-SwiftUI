func report(studentName: String, s1: Double, s2: Double, s3: Double) throws -> (name: String, average: Double, letterGrade: String) {
    var letterGrade = String()
    var name = studentName
    let average: Double = (s1 + s2 + s3) / 3
    
    if average > 90 {
        letterGrade = "A"
        }
        
    else if average > 80 {
        letterGrade = "B"
        }
        
    else if average > 70 {
        letterGrade = "C"
        }
        
    else {
        letterGrade = "F"
        }
    
    if 0 > s1 || 100 < s1 || 0 > s2 || 100 < s2 || 0 > s3 || 100 < s3 {
        throw funcError.scoreError
    }
    return (name, average, letterGrade)
}

do {
    let (name, average, letterGrade) = try report(studentName: "Bob", s1: 90, s2: 100, s3: 90)
    print("Hello \(name) your average is \(average.rounded()) and your letter grade is \(letterGrade)")
} catch funcError.scoreError {
    print("Your grades can't be less than 0 or more than 100.")
}
